# آدرس اتصال به دیتابیس Mongo (از پنل Liara یا MongoDB Atlas می‌گیری)
MONGO_URI=mongodb://username:password@host:port/salon-booking

# یه رشته‌ی تصادفی و طولانی برای امضای JWT (هرگز عمومی نکن)
JWT_SECRET=change-this-to-a-long-random-string

# پورتی که سرور روش بالا میاد (Liara خودش با متغیر PORT مقداردهی می‌کنه)
PORT=4000

# آدرس فرانت‌اند برای تنظیم CORS
CLIENT_ORIGIN=https://your-frontend-domain.ir
